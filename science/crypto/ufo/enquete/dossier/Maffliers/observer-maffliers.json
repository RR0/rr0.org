 "milestones": [
  {
   "t": 4000,
   "label": "A",
   "note": {
    "fr": "La chienne s'arrête net et revient apeurée ; il tourne la tête à droite et voit l'objet immobile devant le bois.",
    "en": "The dog stops dead and runs back frightened; he turns his head right and sees the object standing still before the wood.",
    "es": "La perra se para en seco y vuelve corriendo asustada; él gira la cabeza a la derecha y ve el objeto inmóvil delante del bosque.",
    "it": "Il cane si ferma di colpo e torna indietro spaventato; lui gira la testa a destra e vede l'oggetto fermo davanti al bosco."
   }
  },
  {
   "t": 17000,
   "label": "B",
   "note": {
    "fr": "Une averse tombe d'un coup ; l'objet monte tout droit de quelques mètres.",
    "en": "A shower falls all at once; the object rises straight up a few metres.",
    "es": "Cae un chaparrón de golpe; el objeto sube en vertical unos metros.",
    "it": "Un acquazzone cade tutto d'un colpo; l'oggetto sale dritto di qualche metro."
   }
  },
  {
   "t": 19000,
   "label": "C",
   "note": {
    "fr": "Il s'incline, le bout gauche vers le haut, le droit faisant pivot.",
    "en": "It tilts, left end up, the right end acting as a pivot.",
    "es": "Se inclina, con el extremo izquierdo hacia arriba, y el extremo derecho hace de pivote.",
    "it": "Si inclina, estremità sinistra in alto, con l'estremità destra che fa da perno."
   }
  },
  {
   "t": 20000,
   "label": "D",
   "note": {
    "fr": "Départ vers la gauche et le ciel, le long de sa longueur, trop vite pour être suivi.",
    "en": "Off to the left and up, along its length, too fast to follow.",
    "es": "Se va hacia la izquierda y hacia arriba, en el sentido de su longitud, demasiado rápido para seguirlo.",
    "it": "Se ne va verso sinistra e in alto, nel senso della lunghezza, troppo veloce per seguirlo."
   }
  }
 ],
