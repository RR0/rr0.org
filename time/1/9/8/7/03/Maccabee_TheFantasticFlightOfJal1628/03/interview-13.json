    {
      "speaker": "aartcc",
      "text": "5:38:55 JAL1628 heavy, sir. Does your traffic appear to be staying with you?"
    },
    {
      "speaker": "jal1628",
      "text": "5:38:57 Ah, [unintelligible] distinguished. [He meant extinguished.]"
    },
    {
      "speaker": "aartcc",
      "text": "5:39:01 JAL1628 say again?"
    },
